/*
 * magr_build_config.h -- generated by CMake from cmake/magr_build_config.h.in.
 *
 * DO NOT EDIT. Everything in here is derived from the compiler that is actually
 * running and the flags it was actually given. A hand-written value in a build
 * provenance record is worse than a missing one, because it looks
 * authoritative: it would let a replay claim a numerical backend that was
 * never built.
 *
 * The values are committed into the execution manifest and therefore into a
 * Merkle root. If a build records the wrong compiler, the manifest is wrong and
 * the root is wrong in a way no later verification can detect.
 */

#ifndef MAGR_BUILD_CONFIG_H
#define MAGR_BUILD_CONFIG_H

/* --- Vendored numerical backend --- */
#define MAGR_BLAS_REVISION "@MAGR_BLAS_REVISION@"
#define MAGR_BLAS_ARCHIVE_SHA256 "@MAGR_BLAS_ARCHIVE_SHA256@"

/* --- Toolchain, as reported by CMake --- */
#define MAGR_F77_COMPILER_ID "@MAGR_F77_COMPILER_ID@"
#define MAGR_F77_COMPILER_VERSION "@MAGR_F77_COMPILER_VERSION@"
#define MAGR_F77_COMPILER_FLAGS "@MAGR_F77_COMPILER_FLAGS@"
#define MAGR_BUILD_TYPE "@CMAKE_BUILD_TYPE@"

/* --- ABI --- */
#define MAGR_BUILD_ABI_VERSION "@MAGR_ABI_VERSION_STRING@"

#define MAGR_BUILD_WRAPPER_VERSION "@PROJECT_VERSION@"

/*
 * Whether the Fortran backend was compiled with -ffp-contract=off.
 *
 * A build with contraction enabled is still correct, but it is NOT bit
 * reproducible: the compiler may fuse a*x+y into an FMA, which changes the
 * rounding and therefore the output bits. This macro lets a program state
 * plainly whether it can promise bit-identity, instead of the promise being
 * implicit in a flag nobody reads.
 */
#cmakedefine01 MAGR_F77_FP_CONTRACT_OFF

/*
 * Whether the XERBLA tripwire is bound to the real Fortran SAVE counter.
 *
 * When 0, magr_blas_xerbla_count() reads a private counter that nothing
 * increments, and a clean reading proves nothing. Callers must consult
 * magr_blas_xerbla_interposed() rather than assuming a meaningful answer.
 */
#cmakedefine01 MAGR_XERBLA_INTERPOSE

#endif /* MAGR_BUILD_CONFIG_H */